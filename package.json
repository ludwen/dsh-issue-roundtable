{
  "name": "dsh-issue-roundtable",
  "version": "0.4.0",
  "description": "议题圆桌：圆桌图形界面 + 分组角色库 + Agent 建团队/批量改写 + 按用途与按角色的模型选择 + 多轮讨论与投票表决。",
  "type": "module",
  "main": "dsh/index.js",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node test/smoke.mjs && node test/panel.mjs"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/",
    "lib/",
    "locale/",
    "src/",
    "scripts/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "11018790",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
